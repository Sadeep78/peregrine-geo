# ==============================================================================
# Peregrine Environment Variables
# ==============================================================================

# Node Environment
NODE_ENV=development
PORT=4000
WEB_PORT=3000

# PostgreSQL 16 + PostGIS 3
POSTGRES_USER=peregrine
POSTGRES_PASSWORD=peregrine_dev_pass
POSTGRES_DB=peregrine_dev
POSTGRES_PORT=5432
DATABASE_URL=postgresql://peregrine:peregrine_dev_pass@localhost:5432/peregrine_dev?schema=public

# Redis 7
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# Authentication & Security
JWT_SECRET=peregrine_dev_jwt_secret_min_32_bytes_test_key_0123456789
REFRESH_TOKEN_SECRET=peregrine_dev_refresh_secret_min_32_bytes_test_key_0123456789
SESSION_COOKIE_NAME=peregrine_session
ARGON2_MEMORY_COST=65536
ARGON2_TIME_COST=3

# Webhook Signing Secret (HMAC-SHA256)
WEBHOOK_SIGNING_SECRET=peregrine_dev_webhook_signing_secret_hmac_sha256_key_12345

# Self-Hosted Routing (OSRM)
# Public OSRM demo servers are strictly forbidden in production paths.
OSRM_CAR_URL=http://localhost:5000
OSRM_BIKE_URL=http://localhost:5001
OSRM_FOOT_URL=http://localhost:5002

# Elevation Service (Default: SRTM-based service, Fallback: flat altitude)
ELEVATION_PROVIDER=flat
ELEVATION_API_URL=http://localhost:8080/v1/elevation

# Map & Tiles
NEXT_PUBLIC_MAP_STYLE_URL=https://demotiles.maplibre.org/style.json
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_WS_URL=ws://localhost:4000

# Device Simulator Defaults
SIM_DEVICE_COUNT=10
SIM_INGEST_RATE_HZ=1
